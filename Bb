import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from bert4keras.tokenizers import Tokenizer
from bert4keras.models import build_transformer_model
from bert4keras.backend import keras, K
from bert4keras.optimizers import Adam
from tensorflow.keras.layers import Dense, Input
from tensorflow.keras.models import Model
import os

# Define paths for BERT model
BERT_PATH = "path/to/bert_model"  # Update this with your actual path
config_path = os.path.join(BERT_PATH, "bert_config.json")
checkpoint_path = os.path.join(BERT_PATH, "bert_model.ckpt")
vocab_path = os.path.join(BERT_PATH, "vocab.txt")

# Load tokenizer
tokenizer = Tokenizer(vocab_path)

# Load BERT model
bert = build_transformer_model(config_path=config_path, checkpoint_path=checkpoint_path, return_keras_model=False)

# Extract CLS token output for classification
cls_output = bert.model.output[:, 0]
dense_layer = Dense(128, activation="relu")(cls_output)
output_layer = Dense(6, activation="softmax")(dense_layer)  # 6 categories

# Define final model
model = Model(bert.model.input, output_layer)
model.compile(loss="sparse_categorical_crossentropy", optimizer=Adam(2e-5), metrics=["accuracy"])
